{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algoverse.local/schema/trace/v1",
  "title": "Trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "events",
    "counters",
    "stdout"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "pythonVersion",
        "source",
        "seed",
        "limits",
        "terminatedBy",
        "loops"
      ],
      "properties": {
        "runId": {
          "type": "string"
        },
        "pythonVersion": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "source": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "text",
              "sha256"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        },
        "seed": {
          "type": "integer"
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxSteps",
            "timeoutMs",
            "maxHeapItems"
          ],
          "properties": {
            "maxSteps": {
              "type": "integer",
              "minimum": 0
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 0
            },
            "maxHeapItems": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "terminatedBy": {
          "enum": [
            "completed",
            "step_limit",
            "timeout",
            "error",
            "cancelled"
          ]
        },
        "loops": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "span",
              "kind",
              "depth"
            ],
            "properties": {
              "span": {
                "$ref": "#/$defs/Span"
              },
              "kind": {
                "enum": [
                  "for",
                  "while"
                ]
              },
              "depth": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TraceEvent"
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lines",
        "comparisons",
        "reads",
        "writes",
        "swaps",
        "calls",
        "maxDepth"
      ],
      "properties": {
        "lines": {
          "type": "integer",
          "minimum": 0
        },
        "comparisons": {
          "type": "integer",
          "minimum": 0
        },
        "reads": {
          "type": "integer",
          "minimum": 0
        },
        "writes": {
          "type": "integer",
          "minimum": 0
        },
        "swaps": {
          "type": "integer",
          "minimum": 0
        },
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "stdout": {
      "type": "string"
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "excType",
        "message"
      ],
      "properties": {
        "excType": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "span": {
          "$ref": "#/$defs/Span"
        },
        "friendly": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "ObjId": {
      "type": "string",
      "description": "Stable heap object id, e.g. o17"
    },
    "FrameId": {
      "type": "string",
      "description": "Stable frame id, e.g. f3"
    },
    "Span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "line",
        "col",
        "endLine",
        "endCol"
      ],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "endLine": {
          "type": "integer",
          "minimum": 0
        },
        "endCol": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "container",
        "key"
      ],
      "properties": {
        "container": {
          "$ref": "#/$defs/ObjId"
        },
        "key": {
          "$ref": "#/$defs/Value"
        }
      }
    },
    "Value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "v"
          ],
          "properties": {
            "t": {
              "const": "int"
            },
            "v": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "v"
          ],
          "properties": {
            "t": {
              "const": "float"
            },
            "v": {
              "oneOf": [
                {
                  "type": "number"
                },
                {
                  "enum": [
                    "nan",
                    "inf",
                    "-inf"
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "v"
          ],
          "properties": {
            "t": {
              "const": "bool"
            },
            "v": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "v"
          ],
          "properties": {
            "t": {
              "const": "str"
            },
            "v": {
              "type": "string"
            },
            "truncated": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "t",
            "id"
          ],
          "properties": {
            "t": {
              "const": "ref"
            },
            "id": {
              "$ref": "#/$defs/ObjId"
            }
          }
        }
      ]
    },
    "HeapObject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "typeName",
        "len"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ObjId"
        },
        "kind": {
          "enum": [
            "list",
            "tuple",
            "dict",
            "set",
            "frozenset",
            "deque",
            "instance",
            "function",
            "class",
            "other"
          ]
        },
        "typeName": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Value"
          }
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "$ref": "#/$defs/Value"
              },
              {
                "$ref": "#/$defs/Value"
              }
            ],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          }
        },
        "len": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "FrameInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frameId",
        "func",
        "depth"
      ],
      "properties": {
        "frameId": {
          "$ref": "#/$defs/FrameId"
        },
        "func": {
          "type": "string"
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "StateDelta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "locals": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "$ref": "#/$defs/Value"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "t"
                  ],
                  "properties": {
                    "t": {
                      "const": "deleted"
                    }
                  }
                }
              ]
            }
          }
        },
        "heap": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/HeapObject"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "deleted"
                ],
                "properties": {
                  "deleted": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        "frames": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "push": {
              "$ref": "#/$defs/FrameInfo"
            },
            "pop": {
              "$ref": "#/$defs/FrameId"
            }
          }
        }
      }
    },
    "TraceEvent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth"
          ],
          "properties": {
            "kind": {
              "const": "line"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "func",
            "frameId",
            "args"
          ],
          "properties": {
            "kind": {
              "const": "call"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "func": {
              "type": "string"
            },
            "parent": {
              "$ref": "#/$defs/FrameId"
            },
            "args": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "frameId",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "return"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "excType",
            "message",
            "traceback"
          ],
          "properties": {
            "kind": {
              "const": "exception"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "excType": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "traceback": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Span"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "op",
            "left",
            "right",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "compare"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "op": {
              "enum": [
                "<",
                "<=",
                ">",
                ">=",
                "==",
                "!=",
                "is",
                "in",
                "not in"
              ]
            },
            "left": {
              "$ref": "#/$defs/Value"
            },
            "right": {
              "$ref": "#/$defs/Value"
            },
            "result": {
              "type": "boolean"
            },
            "leftOrigin": {
              "$ref": "#/$defs/Origin"
            },
            "rightOrigin": {
              "$ref": "#/$defs/Origin"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "container",
            "key",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "read"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "container": {
              "$ref": "#/$defs/ObjId"
            },
            "key": {
              "$ref": "#/$defs/Value"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "container",
            "key",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "write"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "container": {
              "$ref": "#/$defs/ObjId"
            },
            "key": {
              "$ref": "#/$defs/Value"
            },
            "old": {
              "$ref": "#/$defs/Value"
            },
            "value": {
              "$ref": "#/$defs/Value"
            },
            "valueOrigin": {
              "$ref": "#/$defs/Origin"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "container",
            "key"
          ],
          "properties": {
            "kind": {
              "const": "delete"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "container": {
              "$ref": "#/$defs/ObjId"
            },
            "key": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "target",
            "method",
            "args",
            "result"
          ],
          "properties": {
            "kind": {
              "const": "method"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "target": {
              "$ref": "#/$defs/ObjId"
            },
            "method": {
              "type": "string"
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Value"
              }
            },
            "result": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "target",
            "attr",
            "value"
          ],
          "properties": {
            "kind": {
              "const": "attr_write"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "target": {
              "$ref": "#/$defs/ObjId"
            },
            "attr": {
              "type": "string"
            },
            "old": {
              "$ref": "#/$defs/Value"
            },
            "value": {
              "$ref": "#/$defs/Value"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "stdout"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "seq",
            "depth",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "note"
            },
            "seq": {
              "type": "integer",
              "minimum": 0
            },
            "span": {
              "$ref": "#/$defs/Span"
            },
            "frameId": {
              "$ref": "#/$defs/FrameId"
            },
            "depth": {
              "type": "integer",
              "minimum": 0
            },
            "delta": {
              "$ref": "#/$defs/StateDelta"
            },
            "text": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/Value"
              }
            }
          }
        }
      ]
    }
  }
}
